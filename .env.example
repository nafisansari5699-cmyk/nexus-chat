# Copy to .env and fill in real values. NEVER commit .env.

# Port the server listens on
PORT=3000

# Secret used to sign JWTs (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string

# How long login tokens stay valid (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Where the JSON database + uploaded media live (defaults: ./data and ./uploads)
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Comma-separated origins allowed to call the API (frontend domain on Netlify etc.)
CORS_ORIGINS=*

# Max upload size in MB
MAX_UPLOAD_MB=10

# Public URL of this deployment (used in share links / CORS hints)
PUBLIC_URL=

# Optional: Twilio/alternative TURN credentials for calls behind strict NATs.
# STUN-only works for most home networks; TURN is needed for some corporate/carrier NATs.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
